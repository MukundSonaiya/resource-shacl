@prefix gx: <https://dev-registry.dynamo-demo.com/development/api/trusted-shape-registry/v1/shapes/jsonld/trustframework#> .
@prefix gx1: <https://registry.lab.gaia-x.eu/development/api/trusted-shape-registry/v1/shapes/jsonld/trustframework#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# (MPC) Membership Party Credential Shape

gx:MembershipPartyCredentialShape a sh:NodeShape ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
       [
            sh:node gx:PostalCodeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:description "Physical location of the datacenters in" ;
            sh:minCount 1 ;            
            sh:order 0 ;
            sh:path gx:datacenterLocation ;
        ],
        [ sh:node gx:LegalParticipantCompliance ;
            sh:nodeKind sh:IRI ;
            sh:description "A resolvable link to Gaia-X Compliance of the participant " ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path gx:legalParticipantCompliance ;
        ],
        [ sh:node gx1:LegalParticipant ;
            sh:nodeKind sh:IRI ;
            sh:description "A resolvable link to Gaia-X participant " ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path gx:legalParticipant ;
        ],
        [
            sh:node gx:PostalCodeShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:description "From where the service is erogated" ;
            sh:minCount 1 ;            
            sh:order 2 ;
            sh:path gx:serviceLocation ;
        ],
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "Y/N certification does not exist, no CAB -> no attachment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:GDPR; 
        ],
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "Attachment Certificate Of Incorporation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:certificateOfIncorporation; 
        ],
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "Attachment Immune From Non EUJurisdiction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:immuneFromNonEUJurisdiction; 
        ],
        [
            sh:node gx:PostalCodeShape ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:description "Physical location of legal registration" ;
            sh:order 6 ;
            sh:path gx:ultimateParentCompany ;
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "Headquarter StreetAddress" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gx:headquarterStreetAddress; 
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "Legal Street Address" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gx:legalStreetAddress; 
        ],
        [
            sh:path gx:certifications ;
            sh:node gx:CertificationsShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:description "Certifications given to the entire organisation (ISO 27001, ISO 27002, ISO 20000-1, ISO 22301)" ;
            sh:order 9 ;
        ];

    sh:targetClass gx:MembershipPartyCredential .

gx:LegalParticipantComplianceShape a sh:NodeShape ;
    sh:description "LegalPerson Compliance Proof" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "LegalPerson Compliance" ;
    sh:property
        [
            sh:path gx:integrity ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "ISO 3166-2 alpha2, alpha-3 or numeric format expected." ;
        ],
        [
            sh:path gx:integrityNormalization ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "ISO 3166-2 alpha2, alpha-3 or numeric format expected." ;
        ],
        [
            sh:path gx:version ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "ISO 3166-2 alpha2, alpha-3 or numeric format expected." ;
        ],
        [
            sh:path gx:type ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "ISO 3166-2 alpha2, alpha-3 or numeric format expected." ;
        ];

    sh:targetClass gx:LegalParticipantCompliance .

gx:PostalCodeShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Postal code of the entity." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Postal Address" ;
    sh:property
        [
            sh:path gx:countryCode ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:pattern "^[A-Z]{2}-[A-Z0-9]{1,3}$" ;
            sh:flags "i" ;
            sh:description "ISO 3166-2 alpha2, alpha-3 or numeric format expected." ;
        ];
    sh:targetClass gx:datacenterLocation, gx:serviceLocation, gx:ultimateParentCompany .

gx:CertificationsShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Certifications given to the entire organisation (ISO 27001, ISO 27002, ISO 20000-1, ISO 22301)" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Certifications" ;
    sh:property
        [
            sh:path gx:name ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "Certification name" ;
            sh:order 0 ;
        ];    
    sh:property
        [
            sh:path gx:certificationID ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "Certification ID (ISO 27001, ISO 27002, ISO 20000-1, ISO 22301)" ;
            sh:order 1 ;
        ];
    sh:property
        [
            sh:path gx:expiryDate ;
            sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "Certification Expiry Date" ;
            sh:order 2 ;
        ];
    sh:property
        [
            sh:path gx:certifyingBody ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:description "Certification body who issues certifications to organisations" ;
            sh:order 3 ;
        ];

    sh:targetClass gx:CertificationsShape .

# (IaaS) Virtual Machine Service Offering Shape

gx:VirtualMachineServiceOfferingShape a sh:NodeShape ;
    sh:description "A digital service available for order and offering computational capabilities." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Virtual Machine Service Offering" ;
    sh:property 
        [ sh:class gx:VMImage ;
            sh:description "Compute Service Code Artifacts" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "code artifact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path gx:codeArtifact ] ,

        [ sh:class gx:ServerFlavor ;
            sh:description "Set of technical requirements or conditions to instantiate this service offering." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "instantiation requirement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path gx:instantiationReq ] ,

        [ sh:description "How compute resources of different tenants are separated. Default value = hw-virtualized." ;
            sh:in ( "hw-virtualized" "sw-virtualized" "os-virtualized" "os-hw-virtualized" "hw-partitioned" "physical" ) ;
            sh:maxCount 1 ;
            sh:name "tenant separation" ;
            sh:order 2 ;
            sh:path gx:tenantSeparation ] ,

        [ sh:class gx1:LegalParticipant ;
            sh:description "A resolvable link to Gaia-X Credential of the participant providing the service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "provided by" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path gx:providedBy ] ,

        [ sh:description "A list of resolvable links to Gaia-X Credentials of service offerings related to the service and that can exist independently of it." ;
            sh:name "depends on" ;
            sh:or ( [ sh:class gx1:ServiceOffering ] [ sh:class gx:VirtualMachineServiceOffering ] ) ;
            sh:order 4 ;
            sh:path gx:dependsOn ] ,

        [ sh:description "A list of resolvable links to Gaia-X Credentials of resources related to the service and that can exist independently of it." ;
            sh:name "aggregation of" ;
            sh:or ( [ sh:class gx1:PhysicalResource ] [ sh:class gx1:SoftwareResource ] [ sh:class gx1:DataResource ] ) ;
            sh:order 5 ;
            sh:path gx:aggregationOfResources ] ,

        [ sh:class gx:TermsAndConditions ;
            sh:description "One or more Terms and Conditions applying to that service." ;
            sh:name "terms and conditions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path gx:serviceOfferingTermsAndConditions ] ,
            
        [ sh:datatype xsd:string ;
            sh:defaultValue "default:allow intent"^^xsd:string ;
            sh:description "Ome or more policies expressed using a DSL (e.g., Rego or ODRL) (access control, throttling, usage, retention, ...). If there is no specified usage policy constraints, the policy should express a simple default: " ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gx:servicePolicy ] ,

        [ sh:description "One or more data protection regimes applying to the service offering." ;
            sh:in ( "GDPR2016" "LGPD2019" "PDPA2012" "CCPA2018" "VCDPA2021" ) ;
            sh:name "data protection regime" ;
            sh:order 8 ;
            sh:path gx:dataProtectionRegime ] ,

        [ sh:class gx1:DataAccountExport ;
            sh:description "One or more methods to export data out of the service." ;
            sh:name "data account export" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path gx:dataAccountExport ] ,     

        [ sh:datatype xsd:string ;
            sh:description "Keywords that describe / tag the service." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path gx:keyword ] ,

        [ sh:description "Provision type of the service" ;
            sh:in ( "Private" "Public" "Hybrid" ) ;
            sh:maxCount 1 ;
            sh:name "provision type" ;
            sh:order 11 ;
            sh:path gx:provisionType ] ,

        [ sh:class gx:Endpoint ;
            sh:description "Endpoint through which the Service Offering can be accessed." ;
            sh:maxCount 1 ;
            sh:name "endpoint" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path gx:endpoint ] ,

        [ sh:description "List of Resource references where service is hosted and can be instantiated. Can refer to availabilty zones, data centers, regions, etc.." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:pattern "^[A-Z]{2}-[A-Z0-9]{1,3}$" ;
            sh:flags "i" ;
            sh:order 13 ;
            sh:path gx:hostedOn ] ,

        [ sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path gx:name ] ,

        [ sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path gx:description ] ,
        
        [ sh:datatype xsd:string ;
            sh:description "Name of Industry Certificate for this Service" ;
            sh:name "industryCertification" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path gx:industryCertification ] ,

        [ sh:datatype xsd:string ;
            sh:description "Name of Security Certificate for this Service" ;
            sh:name "securityCertification" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path gx:securityCertification ] ;

    sh:targetClass gx:VirtualMachineServiceOffering .

gx:VMImageShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Image for virtual machines." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "VM image" ;
    sh:property 
        [ 
            sh:defaultValue "RAW" ;
            sh:description "Disk format og the VM inage. Default \"RAW\"" ;
            sh:in ( "RAW" "QCOW2" "VHD" "VMDK" "ISO" "CVF" "CVA" ) ;
            sh:maxCount 1 ;
            sh:name "VM Image disk format" ;
            sh:order 0 ;
            sh:path gx:vmImageDiskFormat ; ] ,
        [ 
            sh:defaultValue "other" ;
            sh:description "Hypervisor type required by the image" ;
            sh:in ( "quemu" "KVM" "Xen" "ESXi" "Hyper-V" "Cloud Hypervisor" "other" ) ;
            sh:maxCount 1 ;
            sh:name "Hypervisor type" ;
            sh:order 1 ;
            sh:path gx:hypervisorType ; ] ,
        [ 
            sh:defaultValue "other" ;
            sh:description "Type of firmware which which guests are booted." ;
            sh:in ( "BIOS" "UEFI" "other" ) ;
            sh:maxCount 1 ;
            sh:name "Firmware type" ;
            sh:order 2 ;
            sh:path gx:firmwareType ; ] ,
        [ 
            sh:defaultValue "None" ;
            sh:description "Type of physical phenomena hardware random number generator (RNG) this image prefers." ;
            sh:in ( "Electrical noise" "Chaos-based" "Free-running oscillators" "Quantum" "None" ) ;
            sh:maxCount 1 ;
            sh:name "Hardware based random number generator (RNG)" ;
            sh:order 3 ;
            sh:path gx:hwRngTypeOfImage ; ] ,
        [ 
            sh:defaultValue "disabled" ;
            sh:description "Define the action to be performed if server hangs." ;
            sh:in ( "disabled" "reset" "poweroff" "pause" "none" ) ;
            sh:maxCount 1 ;
            sh:name "Watchdog action" ;
            sh:order 4 ;
            sh:path gx:watchDogAction ; ] ,
        [ 
            sh:class gx:MemorySize ;
            sh:description "Size of the image." ;
            sh:maxCount 1 ;
            sh:name "file size" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path gx:fileSize ; ] ,
        [ 
            sh:class gx:OperatingSystem ;
            sh:description "A resolvable link to Gaia-X credential of operation system offered by this image." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "Operating System" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path gx:operatingSystem ; ] ,
        [ 
            sh:class gx:CPU ;
            sh:description "Details with respect to CPU capabilities required to run the image." ;
            sh:maxCount 1 ;
            sh:name "CPU requirements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path gx:cpuReq ; ] ,
        [ 
            sh:class gx:GPU ;
            sh:description "Details with respect to GPU capabilities required to run the image." ;
            sh:maxCount 1 ;
            sh:name "GPU requirements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path gx:gpuReq ; ] ,

        [ 
            sh:class gx:Memory ;
            sh:description "Minimal size of RAM required to run the image." ;
            sh:maxCount 1 ;
            sh:name "Ram requirements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path gx:ramReq ; ] ,
        [ 
            sh:class gx:MemorySize ;
            sh:description "Maximum amount of RAM for the video image." ;
            sh:maxCount 1 ;
            sh:name "Video RAM size" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path gx:videoRamSize ; ] ,
        [ 
            sh:class gx:Disk ;
            sh:description "Minimal size of root disk required to run the image." ;
            sh:maxCount 1 ;
            sh:name "root disk requirements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path gx:rootDiskReq ; ] ,
        [ 
            sh:class gx:Encryption ;
            sh:description "Details with respect to encryption of the images." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path gx:encryption ; ] ,
        [ 
            sh:class gx:CheckSum ;
            sh:description "Details with respect to check sum of the image." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path gx:checkSum ] ,
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "If true, instances of the image are only started, if signature of software, such as firmware or operating system, are valid. Default: False." ;
            sh:maxCount 1 ;
            sh:name "Secure Boot" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path gx:secureBoot ; 
        ] ,   
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "If true, a virtual performance monitoring unit (vPMU) is enable in guest. Default: False" ;
            sh:maxCount 1 ;
            sh:name "Virtual performance monitoring unit" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path gx:vPMU ; 
        ] ,
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "If true, one queue is set for each virtual CPU." ;
            sh:maxCount 1 ;
            sh:name "Multi queues" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path gx:multiQueues ; 
        ] ,
        [ 
            sh:class gx:UpdateStrategy ;
            sh:description "Details on provider's image update strategy of this image. An update strategy defines ..." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path gx:updateStrategy ; 
        ] ,
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "In case an image requires a commercial license to be used (No Freeware), this attribute indicates, if service usage fee includes that license (true) or customer has to bring its own commercial license (False). Default: False" ;
            sh:maxCount 1 ;
            sh:name "License included" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path gx:licenseIncluded ; 
        ] ,
        [ 
            sh:class gx:MaintenanceSubscription ;
            sh:description "Details on maintenance capabilities of vendor of image's operating system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path gx:maintenance ; 
        ] ,
        [ 
            sh:class gx:CheckSum ;
            sh:description "Details on checksum of the software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path gx:checksum ; 
        ] ,
        [ 
            sh:class gx:Signature ;
            sh:description "Details with respect to signature of the software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path gx:signature ; 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "Version of the software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path gx:version ; 
        ] ,
       [ 
            sh:datatype xsd:string ;
            sh:description "Software specific patch number describing patch level of the software." ;
            sh:maxCount 1 ;
            sh:name "Patch level" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path gx:patchLevel ; 
        ] ,
        [ 
            sh:datatype xsd:dateTime ;
            sh:description "Date and time the software was build, formated according to ISO 8601 (UTC - 24 hours)." ;
            sh:maxCount 1 ;
            sh:name "Build Date" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path gx:buildDate ; 
        ] ,
        [ 
            sh:description "A list of copyright owners either as a free form string or as resolvable link to Gaia-X Credential of participants. A copyright owner is a person or organization that has the right to exploit the resource. Copyright owner does not necessarily refer to the author of the resource, who is a natural person and may differ from copyright owner." ;
            sh:name "copyright owned by" ;
            sh:or ( [ sh:class gx1:LegalParticipant ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 25 ;
            sh:path gx:copyrightOwnedBy ; 
        ] ,
        [ 
            sh:description "A list of SPDX identifiers or URL to document." ;
            sh:or ( [ sh:in ( "Glide" "Abstyles" "AFL-1.1" "AFL-1.2" "AFL-2.0" "AFL-2.1" "AFL-3.0" "AMPAS" "AdaCore-doc" "APL-1.0" "Adobe-Glyph" "APAFML" "Adobe-2006" "Adobe-Utopia" "AGPL-1.0-only" "AGPL-1.0-or-later" "Afmparse" "Aladdin" "ADSL" "AMDPLPA" "ANTLR-PD" "ANTLR-PD-fallback" "Apache-1.0" "Apache-1.1" "Apache-2.0" "App-s2p" "AML" "APSL-1.0" "APSL-1.1" "APSL-1.2" "APSL-2.0" "Arphic-1999" "Artistic-1.0" "Artistic-1.0-Perl" "Artistic-1.0-cl8" "Artistic-2.0" "ASWF-Digital-Assets-1.1" "ASWF-Digital-Assets-1.0" "AAL" "Baekmuk" "Bahyph" "Barr" "Beerware" "Bitstream-Charter" "Bitstream-Vera" "BitTorrent-1.0" "BitTorrent-1.1" "BlueOak-1.0.0" "Boehm-GC" "BSL-1.0" "Borceux" "Brian-Gladman-3-Clause" "BSD-1-Clause" "BSD-2-Clause" "BSD-2-Clause-Views" "BSD-3-Clause" "BSD-3-Clause-Clear" "BSD-3-Clause-flex" "BSD-3-Clause-Modification" "BSD-3-Clause-No-Military-License" "BSD-3-Clause-No-Nuclear-License" "BSD-3-Clause-No-Nuclear-License-2014" "BSD-3-Clause-No-Nuclear-Warranty" "BSD-3-Clause-Open-MPI" "BSD-3-Clause-Sun" "BSD-4-Clause-Shortened" "BSD-4-Clause" "BSD-4.3RENO" "BSD-4.3TAHOE" "BSD-Advertising-Acknowledgement" "BSD-Protection" "BSD-Source-Code" "BSD-3-Clause-Attribution" "BSD-Attribution-HPND-disclaimer" "0BSD" "BSD-2-Clause-Patent" "BSD-4-Clause-UC" "BSD-Inferno-Nettverk" "BUSL-1.1" "bzip2-1.0.6" "Caldera" "CECILL-1.0" "CECILL-1.1" "CECILL-2.0" "CECILL-2.1" "CECILL-B" "CECILL-C" "CERN-OHL-1.1" "CERN-OHL-1.2" "CERN-OHL-P-2.0" "CERN-OHL-S-2.0" "CERN-OHL-W-2.0" "CFITSIO" "check-cvs" "checkmk" "ClArtistic" "Clips" "MIT-CMU" "CMU-Mach" "CNRI-Jython" "CNRI-Python" "CNRI-Python-GPL-Compatible" "CPOL-1.02" "CDDL-1.0" "CDDL-1.1" "CDL-1.0" "LOOP" "CPAL-1.0" "CPL-1.0" "CDLA-Permissive-1.0" "CDLA-Permissive-2.0" "CDLA-Sharing-1.0" "Community-Spec-1.0" "C-UDA-1.0" "CATOSL-1.1" "Condor-1.1" "COIL-1.0" "copyleft-next-0.3.0" "copyleft-next-0.3.1" "Cornell-Lossless-JPEG" "CC-BY-1.0" "CC-BY-2.0" "CC-BY-2.5-AU" "CC-BY-2.5" "CC-BY-3.0-AT" "CC-BY-3.0-DE" "CC-BY-3.0-IGO" "CC-BY-3.0-N