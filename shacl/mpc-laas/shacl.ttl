            sh:order 7 ;
            sh:path gx:license ],
        [ sh:datatype xsd:string ;
            sh:description "A  list of policy expressed using a DSL (e.g., Rego or ODRL) (access control, throttling, usage, retention, ...). If there is no specified usage policy constraints on the VirtualResource, the  policy should express a simple default: allow intent" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gx:resourcePolicy ],
        [ sh:description "A resolvable link of resources related to the resource and that can exist independently of it." ;
            sh:name "aggregation of" ;
            sh:or ( [ sh:class gx1:VirtualResource ] ) ;
            sh:order 9 ;
            sh:path gx:aggregationOfResources ],
        [ sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema:name ],
        [ sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema:description ] ;
    sh:targetClass gx:Hypervisor .

gx:MemoryShape a sh:NodeShape ;
    rdfs:subClassOf gx:Device ;
    sh:closed true ;
    sh:description "Details with respect to properties and capabilities of RAM." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:class gx:MemorySize ;
            sh:description "Memory size of RAM." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "memory size" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path gx:memorySize ],

        [ sh:defaultValue "other" ;
            sh:description "DRAM technology name defined by JEDEC." ;
            sh:in ( "SDRAM" "DDR SDRAM" "ECC DRAM" "DDR4" "DDR5" "GDDR5" "GDDR6" "other" ) ;
            sh:maxCount 1 ;
            sh:name "memory class" ;
            sh:order 1 ;
            sh:path gx:memoryClass ],

        [ sh:defaultValue "other" ;
            sh:description "Rank defines the number of memory chip banks and the buffering used to access these." ;
            sh:in ( "1R RDIMM" "2R RDIMM" "4R LRDIMM" "other" ) ;
            sh:maxCount 1 ;
            sh:name "memory rank" ;
            sh:order 2 ;
            sh:path gx:memoryRank ],

        [ sh:datatype xsd:boolean ;
            sh:description "Error connection code allows to detect and correct bit errors in data. True, if error-correction-code is supported by the ram, false otherwise. Default: False." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "error correction code (ecc)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:eccEnabled ],

        [ sh:datatype xsd:boolean ;
            sh:description "If true, encryption of memory at the hardware level is enabled. Default: False." ;
            sh:maxCount 1 ;
            sh:name "Hardware Encryption enabled" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:hardwareEncryption ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor of the device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:vendor ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor specific generation of the device." ;
            sh:maxCount 1 ;
            sh:name "Generation of the device" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gx:generation ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Default over-subscription ratio defines the amount of default over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "default over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gx:defaultOversubscriptionRatio ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Supported over-subscription ratio defines the amount of supported over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "supported over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gx:supportedOversubscriptionRatio ];

    sh:targetClass gx:Memory .

gx:DeviceShape a sh:NodeShape ;
    sh:closed false ;
    sh:description "Details with respect to properties and capabilities of a hardware or virtualized device." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:datatype xsd:string ;
            sh:description "Vendor of the device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:vendor ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor specific generation of the device." ;
            sh:maxCount 1 ;
            sh:name "Generation of the device" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:generation ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Default over-subscription ratio defines the amount of default over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "default over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:defaultOversubscriptionRatio ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Supported over-subscription ratio defines the amount of supported over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "supported over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:supportedOversubscriptionRatio ];

    sh:targetClass gx:Device .

gx:DiskShape a sh:NodeShape ;
    rdfs:subClassOf gx:Device ;
    sh:closed true ;
    sh:description "Capabilities of a physical or virtual hard drive." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class gx:MemorySize ;
            sh:description "The size of the hard drive." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Disk size" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path gx:diskSize ],

        [ sh:defaultValue "other" ;
            sh:description "The type of storage drive." ;
            sh:in ( "local HDD" "local SSD" "magnetic hard drive" "hybrid hard drive" "shared network storage" "other" ) ;
            sh:maxCount 1 ;
            sh:name "Disk Type" ;
            sh:order 1 ;
            sh:path gx:diskType ],

        [ sh:defaultValue "other" ;
            sh:description "Type of disk controller the disk is attached to." ;
            sh:in ( "SATA" "PATA" "SCSI" "SAS" "NVMe" "other" ) ;
            sh:maxCount 1 ;
            sh:name "Disk Bus Type" ;
            sh:order 2 ;
            sh:path gx:diskBusType ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor of the device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:vendor ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor specific generation of the device." ;
            sh:maxCount 1 ;
            sh:name "Generation of the device" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:generation ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Default over-subscription ratio defines the amount of default over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "default over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:defaultOversubscriptionRatio ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Supported over-subscription ratio defines the amount of supported over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "supported over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gx:supportedOversubscriptionRatio ];

    sh:targetClass gx:Disk .

gx:MemorySizeShape a sh:NodeShape ;
    rdfs:subClassOf gx:Quantity ;
    sh:closed true ;
    sh:description "The number of bytes, that can be stored on a digital storage." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Memory size" ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "Unit of physical quantity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:unit;
        ],
        [ 
            sh:datatype xsd:float ;
            sh:description "Value of physical quantity. See https://qudt.org/schema/qudt/value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value;
        ];
    sh:targetClass gx:MemorySize .

gx:StandardConformityShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Details about standard applied to Gaia-X entities." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "Name of the standard." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "title" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:title
        ],
        [ 
            sh:datatype xsd:anyURI ;
            sh:description "Provides a link to schemas or details about applied standards." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "standard reference" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:standardReference;
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "Publisher of the standard." ;
            sh:maxCount 1 ;
            sh:name "publisher" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:publisher
        ] ;
    sh:targetClass gx:StandardConformity .

gx:CheckSumShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Detail on how to calculate or verify a checksum." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Value of the check sum." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:checkSumValue ],
        [ sh:description "Algorithm used to create checksum." ;
            sh:in ( "md5" "sha-1" "sha-256" "sha-384" "sha-512" "sha-3" "ripemd-160" "blake2" "blake3" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path gx:checkSumCalculation ] ;
    sh:targetClass gx:CheckSum .

gx:SignatureShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Value of the signature" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:signatureValue ],

        [ sh:description "Defines the algorithm used to calculate or verify the signature." ;
            sh:in ( "RSA-Signature" "DSA" "KCDSA" "Schnorr" "ECDSA" "ECKDSA" "EC Schnorr" "ECGDSA" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path gx:signatureAlgorithm ],

        [ sh:description "Algorithm used to create hash." ;
            sh:in ( "md5" "sha-1" "sha-256" "sha-384" "sha-512" "sha-3" "ripemd-160" "blake2" "blake3" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path gx:hashAlgorithm ] ;

    sh:targetClass gx:Signature .

gx:EncryptionShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Encryption capabilities of a Gaia-X entity." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:description "Define key management method. Allowed values are: managed, BYOK, HYOK" ;
            sh:in ( "BYOK" "HYOK" "managed" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "key management" ;
            sh:order 1 ;
            sh:path gx:keyManagement ],

        [ sh:description "Supported algorithm used to encrypt." ;
            sh:in ( "RSA" "AES" "3DES" "Blowfish" "Twofish" "SDA" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "encryption algorithm" ;
            sh:order 0 ;
            sh:path gx:cipher ] ;

    sh:targetClass gx:Encryption .

gx:UpdateStrategyShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Cloud service customer expect cloud images to be updated regularly, in order to always get the image with the lasted patches. Technically, an updated image is a new image in cloud service' image catalogue having it's own unique image ID and replaces its old version. It is recommended to hide outdated version, but keep them referencable by its ID for a transition period for customers' convenience. This class defines important aspects of providers image update policy." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:description "Frequency, in which the provider updates the image on a regular basis. Possible values are: yearly, quarterly, monthly, weekly, daily, critical_bug, and never." ;
            sh:in ( "yearly" "quarterly" "monthly" "weekly" "daily" "critical_bug" "never" ) ;
            sh:maxCount 1 ;
            sh:name "Replace Frequency" ;
            sh:order 0 ;
            sh:path gx:replaceFrequency ],

        [ sh:description "Defines, how long outdated and hidden images are available by its ID. Allowed values are \"none\" (none information are given), \"notice\" (outdated version is valid until deprecation notice from provider), \"forever\" (Outdated version will never be deleted), non-negative integer n (latest n version keep available) and date in UTC (outdated version is valid until given date)." ;
            sh:maxCount 1 ;
            sh:name "Old versions Valid until" ;
            sh:or ( [ sh:in ( "none" "notice" ) ] [ sh:in ( "forever" ) ] [ sh:class gx:LatestN ] [ sh:datatype xsd:date ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 2 ;
            sh:path gx:oldVersionsValidUntil ],

        [ sh:datatype xsd:integer ;
            sh:description "Time in hours passed after image's distributor published a critical hot fix and cloud provider updated this image with the critical patch. A critical bug is defined as a security vulnerability with a CVSS score of 9.0 or higher." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:name "Hotfix hours" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:hotfixHours ],

        [ sh:description "Details, how long the image will be provided in image catalogue. Allowed values are \"none\" (none information are given), \"notice\" (image is available until deprecation notice from provider), and date in UTC (date until the image is available)." ;
            sh:maxCount 1 ;
            sh:name "Provided until" ;
            sh:or ( [ sh:in ( "none" "notice" ) ] [ sh:datatype xsd:date ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path gx:providedUntil ] ;

    sh:targetClass gx:UpdateStrategy .

gx:LatestNShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Number of latest N outdated image versions, which will be valid." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value ] ;
    sh:targetClass gx:LatestN .
    
gx:MaintenanceSubscriptionShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "A maintenance subscriptions gives access to bug fixes, security fixes and function updates from software vendor." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:datatype xsd:boolean ;
            sh:description "True, if cloud service user needs a maintenance subscription account from the vendor of image's operating system in order to receive fixes. Default: False." ;
            sh:maxCount 1 ;
            sh:name "Subscription required" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:subscriptionRequired ],

        [ sh:datatype xsd:date ;
            sh:description "Date (UTC) until vendor of image's operating system promises maintenance at least." ;
            sh:maxCount 1 ;
            sh:name "Maintenance until" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:maintainedUntil ],

        [ sh:datatype xsd:boolean ;
            sh:description "True, if cloud  service provider prepared already the image to reviece bug fixes, security fixes and (minor) function updates. Default: False" ;
            sh:maxCount 1 ;
            sh:name "Subscription included" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:subscriptionIncluded ] ;

    sh:targetClass gx:MaintenanceSubscription .

gx:AddressShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Full address of the entity." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The street address of a postal address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://www.w3.org/2006/vcard/ns#street-address> ],
        [ sh:datatype xsd:string ;
            sh:description "The local postal code of the address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:postalCode ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the country." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:countryName ],
        [ sh:datatype xsd:string ;
            sh:description "The locality property specifies the locality (e.g., city) of a postal address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://www.w3.org/2006/vcard/ns#postal-code> ],
        [ sh:class gx:GPSLocation ;
            sh:description "GPS in ISO 6709:2008/Cor 1:2009 format." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path gx:gps ],
        [ sh:datatype xsd:string ;
            sh:description "The region or state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://www.w3.org/2006/vcard/ns#locality> ],
        [ sh:description "Country code in ISO 3166-1 alpha2, alpha-3 or numeric format." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:in ( "AF" "EG" "AX" "AL" "DZ" "VI" "UM" "AS" "AD" "AO" "AI" "AQ" "AG" "GQ" "SY" "AR" "AM" "AW" "AZ" "ET" "AU" "BS" "BH" "BD" "BB" "BE" "BZ" "BJ" "BM" "BT" "VE" "BQ" "BA" "BW" "BV" "BR" "VG" "IO" "BN" "BG" "BF" "BI" "CV" "CL" "CN" "CK" "CR" "CI" "CW" "DK" "CD" "KP" "LA" "DE" "DM" "DO" "DJ" "EC" "MK" "SV" "ER" "EE" "FK" "FO" "FJ" "FI" "FM" "FR" "TF" "GF" "PF" "GA" "GM" "GE" "GH" "GI" "GD" "GR" "GL" "GP" "GU" "GT" "GG" "GN" "GW" "GY" "HT" "HM" "HN" "HK" "IN" "ID" "IM" "IQ" "IE" "IR" "IS" "IL" "IT" "JM" "JP" "YE" "JE" "JO" "KY" "KH" "CM" "CA" "KZ" "QA" "KE" "KG" "KI" "CC" "CO" "KM" "CG" "HR" "CU" "KW" "LS" "LV" "LB" "LR" "LY" "LI" "LT" "LU" "MO" "MG" "MW" "MY" "MV" "ML" "MT" "MP" "MA" "MH" "MQ" "MR" "MU" "YT" "MX" "MC" "MN" "MS" "ME" "MZ" "MM" "NA" "NR" "NP" "NC" "NZ" "NI" "NL" "NE" "NG" "NU" "NF" "False" "OM" "AT" "PK" "PW" "PS" "PA" "PG" "PY" "PE" "PH" "PN" "BO" "PL" "PT" "PR" "KR" "MD" "RE" "RW" "RO" "RU" "SB" "ZM" "WS" "SM" "ST" "SA" "SE" "CH" "SN" "RS" "SC" "SL" "ZW" "SG" "SK" "SI" "SO" "ES" "LK" "BL" "SH" "KN" "LC" "MF" "SX" "PM" "VC" "ZA" "SD" "GS" "SS" "SR" "SJ" "SZ" "TJ" "TW" "TH" "TL" "TG" "TK" "TO" "TT" "TD" "CZ" "TN" "TR" "TM" "TC" "TV" "UG" "UA" "HU" "UY" "UZ" "VU" "VA" "AE" "TZ" "US" "GB" "VN" "WF" "CX" "BY" "EH" "CF" "CY" ) ] [ sh:in ( "AFG" "ALA" "ALB" "DZA" "ASM" "AND" "AGO" "AIA" "ATA" "ATG" "ARG" "ARM" "ABW" "AUS" "AUT" "AZE" "BHS" "BHR" "BGD" "BRB" "BLR" "BEL" "BLZ" "BEN" "BMU" "BTN" "BOL" "BES" "BIH" "BWA" "BVT" "BRA" "IOT" "BRN" "BGR" "BFA" "BDI" "KHM" "CMR" "CAN" "CPV" "CYM" "CAF" "TCD" "CHL" "CHN" "CXR" "CCK" "COL" "COM" "COG" "COD" "COK" "CRI" "CIV" "HRV" "CUB" "CUW" "CYP" "CZE" "DNK" "DJI" "DMA" "DOM" "ECU" "EGY" "SLV" "GNQ" "ERI" "EST" "ETH" "FLK" "FRO" "FJI" "FIN" "FRA" "GUF" "PYF" "ATF" "GAB" "GMB" "GEO" "DEU" "GHA" "GIB" "GRC" "GRL" "GRD" "GLP" "GUM" "GTM" "GGY" "GIN" "GNB" "GUY" "HTI" "HMD" "VAT" "HND" "HKG" "HUN" "ISL" "IND" "IDN" "IRN" "IRQ" "IRL" "IMN" "ISR" "ITA" "JAM" "JPN" "JEY" "JOR" "KAZ" "KEN" "KIR" "PRK" "KOR" "KWT" "KGZ" "LAO" "LVA" "LBN" "LSO" "LBR" "LBY" "LIE" "LTU" "LUX" "MAC" "MKD" "MDG" "MWI" "MYS" "MDV" "MLI" "MLT" "MHL" "MTQ" "MRT" "MUS" "MYT" "MEX" "FSM" "MDA" "MCO" "MNG" "MNE" "MSR" "MAR" "MOZ" "MMR" "NAM" "NRU" "NPL" "NLD" "NCL" "NZL" "NIC" "NER" "NGA" "NIU" "NFK" "MNP" "NOR" "OMN" "PAK" "PLW" "PSE" "PAN" "PNG" "PRY" "PER" "PHL" "PCN" "POL" "PRT" "PRI" "QAT" "SRB" "REU" "ROU" "RUS" "RWA" "BLM" "SHN" "KNA" "LCA" "MAF" "SPM" "VCT" "WSM" "SMR" "STP" "SAU" "SEN" "SYC" "SLE" "SGP" "SXM" "SVK" "SVN" "SLB" "SOM" "ZAF" "SGS" "SSD" "ESP" "LKA" "SDN" "SUR" "SJM" "SWZ" "SWE" "CHE" "SYR" "TWN" "TJK" "TZA" "THA" "TLS" "TGO" "TKL" "TON" "TTO" "TUN" "TUR" "XTX" "TKM" "TCA" "TUV" "UGA" "UKR" "ARE" "GBR" "USA" "UMI" "URY" "UZB" "VUT" "VEN" "VNM" "VGB" "VIR" "WLF" "ESH" "YEM" "ZMB" "ZWE" "XKX" ) ] [ sh:in ( "4" "818" "248" "008" "10" "850" "581" "14" "16" "20" "660" "8" "028" "226" "760" "26" "41" "231" "30" "36" "048" "40" "42" "46" "084" "204" "48" "52" "58" "60" "62" "092" "086" "854" "108" "132" "152" "156" "184" "188" "384" "531" "208" "180" "408" "418" "276" "212" "214" "262" "218" "807" "222" "232" "233" "238" "234" "242" "246" "583" "250" "260" "254" "258" "266" "270" "268" "288" "292" "308" "300" "304" "312" "316" "320" "831" "324" "624" "328" "332" "334" "340" "344" "356" "360" "833" "368" "372" "364" "352" "376" "380" "388" "392" "887" "832" "400" "136" "116" "120" "124" "398" "634" "404" "417" "296" "166" "170" "174" "178" "191" "192" "414" "426" "428" "422" "430" "434" "438" "440" "442" "446" "450" "454" "458" "462" "466" "470" "580" "504" "584" "474" "478" "480" "175" "484" "492" "496" "500" "499" "508" "104" "516" "520" "524" "540" "554" "558" "528" "562" "566" "570" "574" "578" "512" "32" "586" "585" "275" "591" "598" "600" "604" "608" "612" "068" "616" "620" "630" "410" "498" "638" "646" "642" "643" "090" "894" "882" "674" "678" "682" "752" "756" "686" "688" "690" "694" "716" "702" "703" "705" "706" "724" "144" "652" "654" "659" "662" "663" "534" "666" "670" "710" "729" "239" "728" "740" "744" "748" "762" "158" "764" "626" "768" "772" "776" "780" "148" "203" "788" "792" "795" "796" "798" "800" "804" "348" "858" "860" "548" "336" "784" "834" "840" "826" "704" "876" "162" "112" "732" "140" "196" ) ] ) ;
            sh:order 0 ;
            sh:path gx:countryCode ] ;
    sh:targetClass gx:Address .

gx:GPSLocationShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Physical GPS coordinates in ISO 6709:2008/Cor 1:2009 format." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:description "Coordinate representing y horizontal position such as longitude. Negative values west of Prime Meridian and positive values east of Prime Meridian." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "longitude" ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:class gx:GPSUnit ] ) ;
            sh:order 1 ;
            sh:path gx:longitude ],
        [ sh:datatype xsd:string ;
            sh:description "For three-dimensional point locations, a value representing vertical position through either height or depth. Positive direction and units are defined by CRS identifier." ;
            sh:maxCount 1 ;
            sh:name "altitude" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:altitude ],
        [ sh:datatype xsd:string ;
            sh:description "Coordinate Reference System identifier. Framework used to precisely measure locations on the surface of Earth as coordinates." ;
            sh:maxCount 1 ;
            sh:name "crs" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:crs ;
            sh:pattern "^CRS" ],
        [ sh:description "Coordinate representing x horizontal position such as latitude. Negative number south of equator and positive north of equator." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "latitude" ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:class gx:GPSUnit ] ) ;
            sh:order 0 ;
            sh:path gx:latitude ] ;
    sh:targetClass gx:GPSLocation .

gx:GPSUnitShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Definition of a geographical point." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 180 ;
            sh:minCount 1 ;
            sh:minInclusive -180 ;
            sh:name "degrees" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:degrees ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 60 ;
            sh:minInclusive 0 ;
            sh:name "minutes" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:minutes ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 1e+00 ;
            sh:minInclusive 0e+00 ;
            sh:name "decimals" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:decimals ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 60 ;
            sh:minInclusive 0 ;
            sh:name "seconds" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:seconds ] ;
    sh:targetClass gx:GPSUnit .

gx:QuantityShape a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract parent class for all physical quantities, such as frequency, power or length." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "Unit of physical quantity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:unit;
        ],
        [ 
            sh:datatype xsd:integer ;
            sh:description "Value of physical quantity. See https://qudt.org/schema/qudt/value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value;
        ];
    sh:targetClass gx:Quantity .

gx:FrequencyDefinitionShape a sh:NodeShape ;
    rdfs:subClassOf gx:Quantity ;
    sh:closed true ;
    sh:description "Definition of 'Frequency', according to http://qudt.org/quantitykind/FrequencyDefinition." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:float ;
            sh:description "Value of physical quantity. See https://qudt.org/schema/qudt/value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value;
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "Unit of physical quantity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:unit;
        ] ;
    sh:targetClass gx:FrequencyDefinition .

gx:PowerShape a sh:NodeShape ;
    rdfs:subClassOf gx:Quantity ;
    sh:closed true ;
    sh:description "Definition of 'Power', according to http://qudt.org/quantitykind/Power." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "Unit of physical quantity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:unit;
        ],
        [ 
            sh:datatype xsd:float ;
            sh:description "Value of physical quantity. See https://qudt.org/schema/qudt/value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value;
        ];
    sh:targetClass gx:Power .


# (KaaS) Kubernetes ServiceOffering Shape

gx:KubernetesServiceOfferingShape a sh:NodeShape ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:class gx1:LegalParticipant ;
            sh:description "A resolvable link to Gaia-X Credential of the participant providing the service." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "provided by" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path gx:providedBy ] ,

        [ sh:path gx:policy ;
            sh:name "policy" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:description
                "a list of policy expressed using a DSL (e.g., Rego or ODRL) (access control, throttling, usage, retention, …)." ;
            sh:datatype xsd:string
        ] ,

        [ sh:path gx:termsAndConditions ;
            sh:name "terms & conditions" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:description "a resolvable link to the service offering self-description related to the service and that can exist independently of it." ;
            sh:node gx1:SOTermsAndConditions ] ,

        [ sh:path gx:dataAccountExport ;
            sh:name "data account export" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:description "list of methods to export data from your user’s account out of the service" ;
            sh:node gx1:DataAccountExport ] ,

        [ sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:name ] ,

        [ sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:name "Description" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:description ] ,

        [ sh:description "List of Resource references where service is hosted and can be instantiated. Can refer to availabilty zones, data centers, regions, etc.." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:pattern "^[A-Z]{2}-[A-Z0-9]{1,3}$" ;
            sh:flags "i" ;
            sh:order 6 ;
            sh:path gx:hostedOn ] ,

        [ sh:datatype xsd:integer ;
            sh:description "Number of CPU" ;
            sh:name "Number of CPU" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gx:cpuQuantity ] ,
        
        [ sh:class gx:MemorySize ;
            sh:description "Service memory" ;
            sh:name "Service memory" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path gx:memoryQuantity ] ,
        
        [ sh:class gx:MemorySize ;
            sh:description "Maximum allowed storage" ;
            sh:name "Maximum allowed storage" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path gx:storageQuantity ] ,

        [ sh:datatype xsd:integer ;
            sh:description "Number of GPU" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "Number of GPU" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path gx:gpuQuantity ] ,

        [ sh:class gx:DataRate ;
            sh:description "Minimum CellRate" ;
            sh:name "Minimum CellRate" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path gx:minimumCellRate ] ,

        [ sh:datatype xsd:string ;
            sh:description "Regex ensures the version format aligns with Kubernetes common versioning patterns. ex. v1.22.3, v1.22.3-alpha.1, v1.23.0-beta.2, v1.24.0-rc.3 " ;
            sh:name "Kubernetes Version" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:pattern "^1\\.(1[6-9]|[2-9][0-9])\\.\\d+$" ; # Regex pattern for Kubernetes version validation
	        sh:message "Invalid Kubernetes version format. Expected format: '1.x.y' with x >= 16." ;
            sh:path gx:kubernetesVersion ] ,
        
        [ sh:datatype xsd:string ;
            sh:description "Name of Industry Certificate for this Service" ;
            sh:name "industryCertification" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path gx:industryCertification ] ,

        [ sh:datatype xsd:string ;
            sh:description "Name of Security Certificate for this Service" ;
            sh:name "securityCertification" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path gx:securityCertification ] ,
            
        [ sh:description "Kubernetes billing mode" ;
            sh:in ( "Hourly" "Monthly" ) ;
            sh:maxCount 1 ;
            sh:name "Kubernetes Billing Mode" ;
            sh:order 15 ;
            sh:path gx:kubernetesBillingMode ] , 
        
        [ sh:description "A list of resolvable links to Gaia-X Credentials of service offerings related to the service and that can exist independently of it." ;
            sh:name "depends on" ;
            sh:minCount 1 ;
            sh:or ( [ sh:class gx1:ServiceOffering ] [ sh:class gx:VirtualMachineServiceOffering ] ) ;
            sh:order 16 ;
            sh:path gx:dependsOn ] ;

    sh:targetClass gx:KubernetesServiceOffering .

gx:DataRateShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Definition of 'Data Rate', according to http://qudt.org/quantitykind/DataRate." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
		[ sh:datatype xsd:float ;
            sh:description "Value of physical quantity. See https://qudt.org/schema/qudt/value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:value ],

        [ sh:datatype xsd:string ;
            sh:description "Unit of physical quantity. See https://qudt.org/schema/qudt/Unit" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:unit ] ;

    sh:targetClass gx:DataRate .