gx:HypervisorShape a sh:NodeShape ;
    rdfs:subClassOf gx1:SoftwareResource ;
    sh:closed true ;
    sh:description "A special Gaia-X Software Resource describing a hypervisor to provided virtual machines." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
        [ sh:description "The common name of the distribution of the operating system as defined in http://libosinfo.org/." ;
            sh:in ( "quemu" "KVM" "Xen" "ESXi" "Hyper-V" "Cloud Hypervisor" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path gx:hypervisorType ],         
        [ sh:class gx:CheckSum ;
