                        sh:nodeKind sh:Literal ] ) ;
            sh:order 26 ;
            sh:path gx:license ; 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "A  list of policy expressed using a DSL (e.g., Rego or ODRL) (access control, throttling, usage, retention, ...). If there is no specified usage policy constraints on the VirtualResource, the  policy should express a simple default: allow intent" ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path gx:resourcePolicy ; 
        ] ,
        [
            sh:description "A resolvable link of resources related to the resource and that can exist independently of it." ;
            sh:name "aggregation of" ;
            sh:or ( [ sh:class gx1:VirtualResource ] ) ;
            sh:order 28 ;
            sh:path gx:aggregationOfResources ; 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path gx:name ; 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path gx:description; 
        ] ;
    sh:targetClass gx:VMImage .

gx:ServerFlavorShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Description of the available hardware configuration, such as processor, ram and disk capacities, of a physical or virtual servers that can be launched." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Server Flavor" ;
    sh:property 
        [ 
            sh:class gx:CPU ;
            sh:description "CPU capabilities of the flavor." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "CPU requirements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path gx:cpu; 
        ] ,
        [ 
            sh:class gx:Memory ;
            sh:description "Size of RAM of the flavor." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path gx:ram; 
        ],
        [ 
            sh:class gx:GPU ;
            sh:description "GPU capabilities of the flavor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path gx:gpu; 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "Network capabilities of the flavor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:network; 
        ] ,
        [ 
            sh:class gx:Disk ;
            sh:description "Boot volume capabilities of boot volume of the flavor." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "boot volume" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path gx:bootVolume;] ,
        [ 
            sh:class gx:Disk ;
            sh:description "Additional volume capabilities of boot volume of the flavor." ;
            sh:name "additional volume" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path gx:additionalVolume; 
        ] ,
        [ 
            sh:class gx:ConfidentialComputing ;
            sh:description "Details with respect to confidential computing capabilities of the flavor." ;
            sh:maxCount 1 ;
            sh:name "confidential computing" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path gx:confidentialComputing; ] ,
        [ 
            sh:class gx:Hypervisor ;
            sh:description "A resolvable link to Dynamo credential of used hypervisor as Dynamo software resources." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path gx:hypervisor; 
        ] ,
        [ 
            sh:datatype xsd:boolean ;
            sh:defaultValue false ;
            sh:description "Hardware-assisted virtualization, a.k.a. accelerated virtualization or hardware virtualization, enables full virtualization. Full virtualization means to run an unmodified guest operation system in complete isolation by emulating a complete hardware environment." ;
            sh:maxCount 1 ;
            sh:name "Hardware-assisted virtualization" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gx:hardwareAssistedVirtualization; 
        ],
        [ 
            sh:defaultValue "None" ;
            sh:description "Type of physical phenomena hardware random number generator (RNG) of this flavor is based on." ;
            sh:in ( "Electrical noise" "Chaos-based" "Free-running oscillators" "Quantum" "None" ) ;
            sh:maxCount 1 ;
            sh:name "Hardware based random number generator (RNG)" ;
            sh:order 9 ;
            sh:path gx:hwRngTypeOfFlavor; 
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path gx:name;
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path gx:description; 
        ] ;
    sh:targetClass gx:ServerFlavor  .

gx:TermsAndConditionsShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Terms and Conditions applying to a service offering." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "A resolvable link to document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:url 
        ],
        [ 
            sh:datatype xsd:string ;
            sh:description "sha256 hash of the document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:hash 
        ];
    sh:targetClass gx:TermsAndConditions .

gx:EndpointShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "An endpoint is a mean to access and interact with a service or a resource." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ 
            sh:datatype xsd:string ;
            sh:description "The URL of the endpoint where it can be accessed." ;
            sh:maxCount 1 ;
            sh:name "endpoint URL" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:endpointURL 
        ] ,
        [ 
            sh:class gx:StandardConformity ;
            sh:description "Provides information about applied standards." ;
            sh:minCount 1 ;
            sh:name "standard conformity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path gx:standardConformity 
        ] ,
        [ 
            sh:datatype xsd:string ;
            sh:description "The formal description (e.g. openAPI Description) of the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:formalDescription 
        ] ;
    sh:targetClass gx:Endpoint .

gx:CPUShape a sh:NodeShape ;
    rdfs:subClassOf gx:Device ;
    sh:closed true ;
    sh:description "Computational processing unit of virtual and physical machines." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:defaultValue "Other" ;
            sh:description "Architecture of CPU as defined per .name string of structure static const X86CPUDefinition builtin_x86_defs[] defined in https://gitlab.com/qemu-project/qemu/-/blob/master/target/i386/cpu.c. Non-listed architectures to be designated as 'other'" ;
            sh:in ( "x86-32" "x86-64" "AArch-32" "AArch-64" "RISC-V" "Other" ) ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "CPU architecture" ;
            sh:order 0 ;
            sh:path gx:cpuArchitecture ],

        [ sh:datatype xsd:string ;
            sh:description "CPU flags as documented by lscpu and defined in https://github.com/torvalds/linux/blob/master/tools/arch/x86/include/asm/cpufeatures.h. Non-listed flags to be designated as 'other'." ;
            sh:name "CPU flags" ;
            sh:in ( "3DNow!" "ABM" "ADX" "AES" "AMX" "AVX" "AVX2" "AVX-512" "BMI1" "BMI2" "CLMUL" "E3DNow!" "EMMX" "F16C" "FMA3" "FMA4" "FPU" "MKTME" "MMX" "MPX" "PMEM" "PREFETCH" "RdRAND" "SEV" "SGX" "SHA" "SME" "SMM" "SMX" "SSE" "SSE2" "SSE3" "SSE4.1" "SSE4.2" "SSE4a" "SSE5" "SSSE3" "TBM" "TME" "TSME" "TSX" "XOP" ) ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path gx:cpuFlag ],

        [ sh:datatype xsd:boolean ;
            sh:description "Is simultaneous multithreading (SMT) or hyper threading (HT) active in this CPU? Default \"False\"." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "smt enabled" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:smtEnabled ],

        [ sh:datatype xsd:integer ;
            sh:description "Number of cores of the CPU." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "Number of CPU cores" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:numberOfCores ],

        [ sh:datatype xsd:integer ;
            sh:description "Number of threads of the CPU." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "Number of threads" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:numberOfThreads ],

        [ sh:class gx:FrequencyDefinition ;
            sh:description "Base frequency of the CPU." ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "base CPU frequency" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path gx:baseFrequency ],

        [ sh:class gx:FrequencyDefinition ;
            sh:description "Boost frequency of the CPU." ;
            sh:maxCount 1 ;
            sh:name "boost CPU frequency" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path gx:boostFrequency ],

        [ sh:class gx:MemorySize ;
            sh:description "Last Level Cache size of the CPU." ;
            sh:maxCount 1 ;
            sh:name "last level cache size" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path gx:lastLevelCacheSize ],

        [ sh:class gx:Power ;
            sh:description "CPU Thermal Design Power." ;
            sh:maxCount 1 ;
            sh:name "thermal design power" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path gx:thermalDesignPower ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor of the device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path gx:vendor ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor specific generation of the device." ;
            sh:maxCount 1 ;
            sh:name "Generation of the device" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path gx:generation ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Default over-subscription ratio defines the amount of default over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "default over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path gx:defaultOversubscriptionRatio ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Supported over-subscription ratio defines the amount of supported over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "supported over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path gx:supportedOversubscriptionRatio ] ;

    sh:targetClass gx:CPU .

gx:GPUShape a sh:NodeShape ;
    rdfs:subClassOf gx:Device ;
    sh:closed true ;
    sh:description "Graphical processing unit of virtual and physical machines." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        [ sh:class gx:MemorySize ;
            sh:description "Size of memory of the GPU." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path gx:gpuMemory ],

        [ sh:defaultValue "none" ;
            sh:description "Interconnection of multiple GPUs within a server system" ;
            sh:in ( "NVLink" "RoCE2" "Xe Link" "Infinity Fabric" "other" "none" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path gx:gpuInterconnection ],

        [ sh:datatype xsd:integer ;
            sh:description "Number of processing units, also called compute units, execution units or streaming multiprocessors, of the GPU." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "gpu processing units" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:gpuProcessingUnits ],

        [ sh:datatype xsd:boolean ;
            sh:description "If true, GPU is provided via passthrough, otherwise GPU is virtualized." ;
            sh:maxCount 1 ;
            sh:name "GPU path through" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gx:gpuPassthrough ],
        
        [ sh:datatype xsd:string ;
            sh:description "Vendor of the device." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:vendor ],

        [ sh:datatype xsd:string ;
            sh:description "Vendor specific generation of the device." ;
            sh:maxCount 1 ;
            sh:name "Generation of the device" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:generation ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Default over-subscription ratio defines the amount of default over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "default over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gx:defaultOversubscriptionRatio ],

        [ sh:datatype xsd:integer ;
            sh:description "Over-subscription means assigning more capacity to virtual machines that the physical device has. Supported over-subscription ratio defines the amount of supported over-subscription as a value larger or equal to 1.0. 1.0 means no over-subscription." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:name "supported over-subscription ratio" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gx:supportedOversubscriptionRatio ] ;

    sh:targetClass gx:GPU .

gx:ConfidentialComputingShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
        [ sh:datatype xsd:string ;
            sh:description "Particular confidential computing technology used by the flavors as defined in..." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:technology ],

        [ sh:datatype xsd:anyURI ;
            sh:description "indicates whether confidential server has an associated attestation service." ;
            sh:maxCount 1 ;
            sh:name "attestation service URI" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gx:attestationServiceURI ];

    sh:targetClass gx:ConfidentialComputing .

gx:OperatingSystemShape a sh:NodeShape ;
    rdfs:subClassOf gx1:SoftwareResource ;
    sh:description "A special Gaia-X Software Resource describing an operating system." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:name "Operation System" ;
    sh:property 
        [ sh:datatype xsd:string ;
            sh:description "A free text description of the entity." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema:description ],

        [ sh:class gx:CheckSum ;
            sh:description "Details on checksum of the software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path gx:checksum ],

        [ sh:datatype xsd:string ;
            sh:description "Software specific patch number describing patch level of the software." ;
            sh:maxCount 1 ;
            sh:name "Patch level" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gx:patchLevel ],

        [ sh:datatype xsd:string ;
            sh:description "A  list of policy expressed using a DSL (e.g., Rego or ODRL) (access control, throttling, usage, retention, ...). If there is no specified usage policy constraints on the VirtualResource, the  policy should express a simple default: allow intent" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gx:resourcePolicy ],

        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time the software was build, formated according to ISO 8601 (UTC - 24 hours)." ;
            sh:maxCount 1 ;
            sh:name "Build Date" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gx:buildDate ],

        [ sh:datatype xsd:string ;
            sh:description "A human readable name of the entity." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema:name ],

        [ sh:description "A list of copyright owners either as a free form string or as resolvable link to Gaia-X Credential of participants. A copyright owner is a person or organization that has the right to exploit the resource. Copyright owner does not necessarily refer to the author of the resource, who is a natural person and may differ from copyright owner." ;
            sh:name "copyright owned by" ;
            sh:or ( [ sh:class gx1:LegalParticipant ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 6 ;
            sh:path gx:copyrightOwnedBy ],

        [ sh:description "The common name of the distribution of the operating system as defined in http://libosinfo.org/." ;
            sh:in ( "Alpine Linux" "Arch Linux" "CentOS Linux" "Debian" "Fedora" "FreeBSD" "Gentoo Linux" "Mandrakelinux" "Mandriva Linux" "Mandriva Enterprise Server" "MS-DOS" "NetBSD" "Novell NetWare" "OpenBSD" "OpenSolaris" "openSUSE" "Rocky Linux" "Red Hat Enterprise Linux" "SUSE Linux Enterprise Server" "Ubuntu" "Microsoft Windows" "CirrOS" "AlmaLinux" "others" ) ;
            sh:minCount 1 ;
            sh:name "Operation System Distribution" ;
            sh:order 0 ;
            sh:path gx:osDistribution ],

        [ sh:description "A resolvable link of resources related to the resource and that can exist independently of it." ;
            sh:name "aggregation of" ;
            sh:or ( [ sh:class gx1:VirtualResource ] ) ;
            sh:order 9 ;
            sh:path gx:aggregationOfResources ],

        [ sh:class gx:Signature ;
            sh:description "Details with respect to signature of the software." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path gx:signature ],

        [ sh:description "A list of SPDX identifiers or URL to document." ;
