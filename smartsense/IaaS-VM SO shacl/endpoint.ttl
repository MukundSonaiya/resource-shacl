@prefix gx: <https://registry.lab.gaia-x.eu/development/api/trusted-shape-registry/v1/shapes/jsonld/trustframework#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gx:EndpointShape a sh:NodeShape ;
    sh:closed true ;
    sh:description "An endpoint is a mean to access and interact with a service or a resource." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "The URL of the endpoint where it can be accessed." ;
            sh:maxCount 1 ;
            sh:name "endpoint URL" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gx:endpointURL ],

        [ sh:class gx:StandardConformity ;
            sh:description "Provides information about applied standards." ;
            sh:minCount 1 ;
            sh:name "standard conformity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path gx:standardConformity ],

        [ sh:datatype xsd:string ;
            sh:description "The formal description (e.g. openAPI Description) of the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gx:formalDescription ] ;
            
    sh:targetClass gx:Endpoint .