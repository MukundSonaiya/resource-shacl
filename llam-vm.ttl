        sh:path gx:vendor ;
        sh:node gx:LegalPersonShape ;
        sh:maxCount 1 ;
    ] ;
    
    # license
    sh:property [
        sh:path gx:license ;
        sh:node gx:LicenseShape ;
        sh:maxCount 1 ;
    ] ;
    
    # checksum
    sh:property [
        sh:path gx:checksum ;
        sh:node gx:CheckSumShape ;
        sh:minCount 1 ;
    ] ;
    
    # signature
    sh:property [
        sh:path gx:signature ;
        sh:node gx:SignatureShape ;
        sh:minCount 1 ;
    ] .
    
