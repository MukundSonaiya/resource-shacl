# Endpoint Shape
gx:EndpointShape
    a sh:NodeShape ;
    
    # url
    sh:property [
        sh:path gx:url ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    
    # protocol
    sh:property [
        sh:path gx:protocol ;
        sh:in ( "HTTP" "HTTPS" "FTP" "SFTP" ) ;
        sh:maxCount 1 ;
    ] ;
    
    # port
    sh:property [
        sh:path gx:port ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] .
    
# CPU Shape
gx:CPUShape
    a sh:NodeShape ;
    
    # cores
    sh:property [
        sh:path gx:cores ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
    ] ;
    
    # speed
    sh:property [
        sh:path gx:speed ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    
    # architecture
    sh:property [
        sh:path gx:architecture ;
        sh:in ( "x86" "x64" "ARM" ) ;
        sh:maxCount 1 ;
    ] .
    
