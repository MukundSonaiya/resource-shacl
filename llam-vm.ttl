        sh:maxCount 1 ;
    ] ;
    
    # signature
    sh:property [
        sh:path gx:signature ;
        sh:node gx:SignatureShape ;
        sh:maxCount 1 ;
    ] ;
    
    # version
    sh:property [
        sh:path gx:version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    # patchLevel
    sh:property [
        sh:path gx:patchLevel ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    # buildDate
    sh:property [
        sh:path gx:buildDate ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    
    # copyrightOwnedBy
    sh:property [
        sh:path gx:copyrightOwnedBy ;
        sh:node gx:LegalPersonShape ;
        sh:maxCount 1 ;
    ] ;
    
    # openSourceLicenseType
    sh:property [
        sh:path gx:openSourceLicenseType ;
