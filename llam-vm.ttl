    # keyword
    sh:property [
        sh:path gx:keyword ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    # licenseType
    sh:property [
        sh:path gx:licenseType ;
        sh:node gx:LicenseShape ;
        sh:maxCount 1 ;
    ] .
    
