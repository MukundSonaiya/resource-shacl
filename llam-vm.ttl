# VMDiskType Shape
gx:VMDiskTypeShape
    a sh:NodeShape ;
    
    # type
    sh:property [
        sh:path gx:type ;
        sh:in ( "QCOW2" "RAW" "VMDK" "VDI" ) ;
        sh:maxCount 1 ;
    ] .
    
# HypervisorType Shape
gx:HypervisorTypeShape
