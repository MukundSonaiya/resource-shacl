@prefix gx: <https://registry.lab.gaia-x.eu/development/api/trusted-shape-registry/v1/shapes/jsonld/trustframework#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Virtual Machine Service Offering Shape
gx:VirtualMachineServiceOfferingShape
    a sh:NodeShape ;
    sh:targetClass gx:VirtualMachineServiceOffering ;
    
    # codeArtifact
    sh:property [
        sh:path gx:codeArtifact ;
        sh:node gx:VMImageShape ;
        sh:minCount 1 ;
    ] ;
    
    # instantiationReq
    sh:property [
        sh:path gx:instantiationReq ;
        sh:node gx:ServerFlavorShape ;
        sh:minCount 1 ;
    ] ;

    # tenantSeparation
    sh:property [
        sh:path gx:tenantSeparation ;
        sh:in ( "hw-virtualized" "sw-virtualized" "os-virtualized" "os-hw-virtualized" "hw-partitioned" "physical" ) ;
        sh:maxCount 1 ;
    ] ;

    # providedBy
    sh:property [
        sh:path gx:providedBy ;
        sh:node gx:LegalPersonShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # dependsOn
    sh:property [
        sh:path gx:dependsOn ;
        sh:datatype xsd:string ;
    ] ;

    # aggregationOfResources
    sh:property [
        sh:path gx:aggregationOfResources ;
        sh:datatype xsd:string ;
    ] ;

    # serviceOfferingTermsAndConditions
    sh:property [
        sh:path gx:serviceOfferingTermsAndConditions ;
        sh:node gx:TermsAndConditionsShape ;
        sh:minCount 1 ;
    ] ;

    # servicePolicy
    sh:property [
        sh:path gx:servicePolicy ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;

    # dataProtectionRegime
    sh:property [
        sh:path gx:dataProtectionRegime ;
        sh:in ( "GDPR2016" "LGPD2019" "PDPA2012" "CCPA2018" "VCDPA2021" ) ;
    ] ;

    # dataAccountExport
    sh:property [
        sh:path gx:dataAccountExport ;
        sh:node gx:DataAccountExportShape ;
        sh:minCount 1 ;
    ] ;

    # keyword
    sh:property [
        sh:path gx:keyword ;
        sh:datatype xsd:string ;
    ] ;

    # provisionType
    sh:property [
        sh:path gx:provisionType ;
        sh:in ( "Private" "Public" "Hybrid" ) ;
        sh:maxCount 1 ;
    ] ;

    # endpoint
    sh:property [
        sh:path gx:endpoint ;
        sh:node gx:EndpointShape ;
        sh:maxCount 1 ;
    ] ;

    # hostedOn
    sh:property [
        sh:path gx:hostedOn ;
        sh:datatype xsd:string ;
    ] ;

    # name
    sh:property [
        sh:path gx:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    # description
    sh:property [
        sh:path gx:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# Legal Person Shape
gx:LegalPersonShape
    a sh:NodeShape ;
    
    # registrationNumber
    sh:property [
        sh:path gx:registrationNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    
    # legalAddress
    sh:property [
        sh:path gx:legalAddress ;
        sh:node gx:AddressShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    # headquartersAddress
    sh:property [
        sh:path gx:headquartersAddress ;
        sh:node gx:AddressShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    # parentOrganizationOf
    sh:property [
        sh:path gx:parentOrganizationOf ;
        sh:node gx:LegalPersonShape ;
    ] ;
    
    # subOrganisationOf
    sh:property [
        sh:path gx:subOrganisationOf ;
        sh:node gx:LegalPersonShape ;
    ] ;
    
    # name
    sh:property [
        sh:path gx:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    # description
    sh:property [
        sh:path gx:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

