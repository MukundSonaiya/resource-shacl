    # vPMU
    sh:property [
        sh:path gx:vPMU ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    
    # multiQueues
    sh:property [
        sh:path gx:multiQueues ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    
    # updateStrategy
    sh:property [
        sh:path gx:updateStrategy ;
        sh:node gx:UpdateStrategyShape ;
        sh:maxCount 1 ;
    ] ;
    
    # licenseIncluded
    sh:property [
        sh:path gx:licenseIncluded ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    
    # maintenance
    sh:property [
        sh:path gx:maintenance ;
